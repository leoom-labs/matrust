---
import Logo from './Logo.astro';
const github = 'https://github.com/leoom-labs/matrust';
// Download is the header's primary button, not a nav link; the mobile sheet lists it.
const links = [['Try online','/try/'],['Docs','/docs/'],['Benchmarks',`${github}/blob/main/BENCHMARKS.md`],['GitHub',github]];
const menuLinks = [links[0], ['Download','/download/'], ...links.slice(1)];
// App pages use the wide container, so header and content share their edges.
interface Props { wide?: boolean; }
const { wide = false } = Astro.props;
---
<header class="site-header">
  <div class:list={['container', 'header-inner', { wide }]}>
    <a class="brand" href="/" aria-label="MatRust home"><Logo />MatRust</a>
    <nav class="header-nav" aria-label="Main navigation">
      {links.map(([label, href]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined} class:list={{'github-link':label==='GitHub'}}>{label==='GitHub' && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.83c.85 0 1.71.11 2.51.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.58 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>}{label}</a>)}
    </nav>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme">Dark</button>
    <a class="button primary header-download" href="/download/">Download</a>
    <button class="menu-toggle" id="menu-toggle" type="button" aria-haspopup="dialog" aria-controls="mobile-menu">Menu</button>
  </div>
  <dialog id="mobile-menu" class="mobile-menu" aria-label="Navigation menu">
    <button class="dialog-close" id="menu-close" type="button">Close menu</button>
    <nav aria-label="Mobile navigation">{menuLinks.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
  </dialog>
</header>
