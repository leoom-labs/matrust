{
  "name": "matrust-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev",
    "check": "node scripts/astro.mjs check && tsc --noEmit",
    "build": "node scripts/copy-engine.mjs && node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview",
    "test": "playwright test",
    "refresh-release": "node scripts/refresh-release.mjs",
    "proof": "node --test tests/source.test.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@types/node": "22.20.5",
    "astro": "7.4.2",
    "marked": "18.1.2",
    "playwright": "1.63.0",
    "typescript": "~6.0.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
