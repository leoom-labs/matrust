# Preserve exact fixture, source and evidence bytes for recorded SHA-256 hashes.
* -text
*.pdf binary
*.mat binary
*.fig binary
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.tif binary
*.tiff binary
# Tracked files keep CRLF where they have it: a CR before LF is not trailing whitespace for git diff --check.
* whitespace=cr-at-eol
*.patch -whitespace
